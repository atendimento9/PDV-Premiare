---
import ProductImage from "./ProductImage.astro";
import type { Product } from "../types/catalog";

type Props = {
  product: Product;
  index?: number;
  priority?: boolean;
  /**
   * Numa pagina de categoria todos os cards repetiriam o mesmo rotulo que ja
   * esta no h1 — sete vezes a mesma frase, em duas linhas cada. Ali o rotulo
   * sai e o titulo sobe.
   */
  showCategory?: boolean;
};
const {
  product,
  index = 0,
  priority = false,
  showCategory = true,
} = Astro.props;
const href = `/produto/${product.slug}`;
---

<article class="card">
  <div class="card__media">
    <a class="card__media-link" href={href} tabindex="-1" aria-hidden="true">
      <ProductImage product={product} priority={priority} />
    </a>
  </div>

  <div class="card__body">
    {/* O selo mora aqui no HTML, mas so no celular ele e lido no fluxo. Da
        tablet para cima ele sai do fluxo e vai para cima da foto: dentro do
        texto, ele empurrava o titulo e desalinhava os cards da mesma fileira.
        No celular a lista tem uma coluna so — nao ha fileira para desalinhar, e
        sobre uma foto de 112 px o rotulo nao caberia. */}
    {product.featured && <p class="card__badge">Seleção Premiare</p>}
    {showCategory && <p class="utility card__category">{product.category.name}</p>}
    <h3 class="card__title">
      <a href={href}>{product.name}</a>
    </h3>
  </div>

  {/* A faixa amarela fecha o card com o que um comprador B2B procura antes de
      abrir a ficha. Nunca preco, avaliacao ou estoque. */}
  {
    product.minimumQuantity && (
      <dl class="card__plate">
        <dt class="utility">Mínimo</dt>
        <dd>{product.minimumQuantity.originalText}</dd>
      </dl>
    )
  }

  <a class="card__link" href={href}>
    Ver detalhes<span class="visually-hidden"> de {product.name}</span>
    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
      <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </a>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    position: relative;
    /* Preenche a celula da grade. Sem isto o card para na altura do proprio
       conteudo, o `margin: auto` da faixa nunca sobra e as faixas amarelas
       ficam em alturas diferentes na mesma linha. */
    height: 100%;
    background: var(--brand-white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--dur-base) var(--ease),
      border-color var(--dur-base) var(--ease), box-shadow var(--dur-base) var(--ease);
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: var(--line-strong);
    box-shadow: var(--shadow-2);
  }

  .card__media {
    background: var(--brand-white);
    overflow: hidden;
  }

  .card__media-link {
    display: block;
    padding: var(--space-m);
  }

  .card__media :global(img) {
    transition: transform var(--dur-base) var(--ease);
  }

  .card:hover .card__media :global(img) {
    transform: scale(1.02);
  }

  .card__body {
    display: grid;
    gap: var(--space-2xs);
    align-content: start;
    padding: 0 var(--space-m) var(--space-m);
  }

  .card__category {
    margin: 0;
  }

  @media (min-width: 560px) {
    /* Duas linhas reservadas: o nome mais longo do vocabulario ocupa duas e os
       curtos, uma. Com a altura fixa, todo titulo da fileira comeca na mesma
       altura. Nao vale no celular, onde a lista tem uma coluna so — ali a
       reserva seria espaco vazio sem fileira para alinhar. */
    .card__category {
      min-height: 2.8em;
    }
  }

  .card__title {
    font-size: var(--step-1);
    font-weight: var(--weight-strong);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .card__title a {
    display: inline-block;
    /* Sobe o alvo acima do minimo de 24 px sem depender da excecao da WCAG
       (o card ja tem "Ver detalhes" para o mesmo destino). */
    padding-block: 3px;
    color: var(--brand-blue);
    text-decoration: none;
  }

  .card__title a:hover {
    text-decoration: underline;
  }

  .card__badge {
    justify-self: start;
    margin: 0;
    padding: 3px var(--space-xs);
    background: var(--blue-100);
    color: var(--brand-blue);
    border-radius: 999px;
    font-size: var(--utility-size);
    font-weight: var(--utility-weight);
    letter-spacing: 0.06em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  @media (min-width: 560px) {
    .card__badge {
      position: absolute;
      inset-block-start: var(--space-s);
      inset-inline-start: var(--space-s);
      z-index: 1;
    }
  }

  .card__plate {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    margin: auto 0 0;
    padding: var(--space-s) var(--space-m);
    border-block-start: 3px solid var(--brand-yellow);
    background: var(--surface-muted);
  }

  .card__plate dt,
  .card__plate dd {
    margin: 0;
  }

  .card__plate dd {
    font-size: var(--step--1);
    font-weight: var(--weight-strong);
    color: var(--brand-blue);
    white-space: nowrap;
  }

  .card__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
    min-height: 48px;
    padding-inline: var(--space-m);
    border-block-start: 1px solid var(--line);
    color: var(--brand-blue);
    font-size: var(--step--1);
    font-weight: var(--weight-strong);
    text-decoration: none;
  }

  .card__link:hover {
    background: var(--blue-100);
  }

  /* --------------------------------------------------------------- celular
     Ate 560 px a grade tem uma coluna so, e o card vertical vira um bloco de
     ~700 px: doze produtos custavam 9.000 px de rolagem so para varrer o
     catalogo. Aqui a foto encolhe para 112 px e vai para o lado do texto, e o
     mesmo card passa a ocupar cerca de um quarto disso. Quem quiser ver a peca
     grande abre a ficha, onde a foto e o assunto principal.

     Vem por ultimo de proposito: e a mesma especificidade das regras acima, e
     precisa vencer no empate. */
  @media (max-width: 559px) {
    .card {
      display: grid;
      grid-template-columns: 112px minmax(0, 1fr);
      grid-template-areas:
        "media body"
        "plate plate"
        "link link";
    }

    .card__media {
      grid-area: media;
      align-self: start;
    }

    .card__media-link {
      padding: var(--space-s);
    }

    .card__body {
      grid-area: body;
      padding: var(--space-s) var(--space-m) var(--space-s) 0;
    }

    .card__plate {
      grid-area: plate;
      /* `margin: auto` empurrava a faixa para o fim da coluna flex; numa grade
         ele centraliza o item e desalinha a faixa. */
      margin: 0;
    }

    .card__link {
      grid-area: link;
    }

    .card__title {
      font-size: var(--step-0);
    }
  }
</style>
