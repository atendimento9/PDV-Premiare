---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CatalogBrowser from "../components/CatalogBrowser.astro";
import { byEditorialPriority, categories, products } from "../lib/catalog";

const items = byEditorialPriority(products);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Início", item: new URL("/", Astro.site).href },
      { "@type": "ListItem", position: 2, name: "Catálogo", item: new URL("/catalogo", Astro.site).href },
    ],
  },
];
---

<Base
  title="Catálogo AA e AAA de presentes corporativos"
  description={`Seleção de ${products.length} produtos AA e AAA em ${categories.length} categorias: kits, presentes premium e soluções personalizadas para empresas.`}
  path="/catalogo"
  jsonLd={jsonLd}
>
  <div class="container">
    <Breadcrumbs items={[{ label: "Catálogo" }]} />

    <header class="page-head">
      <span class="rule-band"></span>
      <p class="utility">Catálogo</p>
      <h1>Presentes corporativos AA e AAA</h1>
      <p class="lede">
        {products.length} itens selecionados em {categories.length} categorias, com foco em
        kits, experiências e produtos de maior valor percebido. A equipe adapta
        a composição e confirma a personalização no atendimento.
      </p>
    </header>
  </div>

  <div class="container catalog-body">
    <CatalogBrowser items={items} />
  </div>
</Base>

<style>
  .catalog-body {
    padding-block-end: var(--space-4xl);
  }
</style>
