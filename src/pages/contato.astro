---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import PendingBlock from "../components/PendingBlock.astro";
import {
  formatWhatsApp,
  generalMessage,
  hasEmail,
  hasWhatsApp,
  mailtoLink,
  siteConfig,
  whatsappLink,
} from "../config/site";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Início", item: new URL("/", Astro.site).href },
      { "@type": "ListItem", position: 2, name: "Contato", item: new URL("/contato", Astro.site).href },
    ],
  },
];

/**
 * O endereco do CNPJ nao entra na lista de canais: e endereco cadastrado, nao
 * ponto de atendimento, e ali seria lido como convite a aparecer. Ele fica no
 * bloco de identificacao, no fim da pagina, onde e dado da empresa.
 */
const zapChannels = siteConfig.attendants.map((a) => ({
  name: a.name,
  label: formatWhatsApp(a.whatsapp),
  href: whatsappLink(a.whatsapp, generalMessage()),
}));

const mailChannels = siteConfig.emails.map((address) => ({
  label: address,
  href: mailtoLink(address, "Contato pelo site — Premiare Criativa"),
}));

/**
 * Nada aqui e obrigatorio para falar com a equipe — e a lista do que faz a
 * primeira resposta ja vir com proposta, em vez de vir com perguntas.
 */
const briefing = [
  {
    label: "Ocasião",
    text: "Onboarding, convenção, premiação, fim de ano, evento ou campanha interna.",
  },
  {
    label: "Público",
    text: "Quem recebe: colaboradores, lideranças, clientes, parceiros ou convidados.",
  },
  {
    label: "Quantidade estimada",
    text: "Mesmo aproximada, ela já orienta o que é possível.",
  },
  {
    label: "Prazo desejado",
    text: "A data em que o material precisa estar na mão de quem recebe.",
  },
  {
    label: "Produtos de interesse",
    text: "Se algo do catálogo já chamou atenção, o nome do item ajuda.",
  },
  {
    label: "Arquivos da marca",
    text: "Logotipo e manual, se houver, para avaliar a aplicação.",
  },
];
---

<Base
  title="Contato"
  description="Fale com a equipe da Premiare Criativa por WhatsApp ou e-mail sobre brindes corporativos, kits e projetos personalizados."
  path="/contato"
  jsonLd={jsonLd}
>
  <div class="container">
    <Breadcrumbs items={[{ label: "Contato" }]} />

    <header class="page-head">
      <span class="rule-band"></span>
      <p class="utility">Contato</p>
      <h1>Fale com a equipe</h1>
      <p class="lede">
        Conte a ocasião, o público e a quantidade estimada. A equipe volta com uma
        composição e as condições.
      </p>
    </header>

    {/* Preenchido no cliente com o que veio do botao de orcamento. Fica oculto
        quando a pessoa chega direto ao /contato. */}
    <aside class="brief" data-brief hidden>
      <p class="utility">Sobre o seu pedido</p>
      <p class="brief__item" data-brief-subject hidden></p>
      <p class="brief__item" data-brief-qty hidden></p>
      <p class="brief__text" data-brief-desc hidden></p>
      <p class="brief__note">
        Guarde estes dados: eles ajudam a equipe a responder já com uma proposta.
      </p>
    </aside>

    <div class="contact">
      <div class="contact__main">
        {
          !hasWhatsApp && !hasEmail && (
            <PendingBlock
              title="Canais de atendimento"
              hint="Número de WhatsApp com DDI, telefone, e-mail comercial e endereço. Enquanto não forem informados, nenhum canal é publicado: um contato incorreto é pior do que a ausência dele."
              note="WhatsApp, telefone e e-mail ainda não foram publicados nesta página. Nenhum contato é exibido antes de ser confirmado pela Premiare — um canal incorreto atrasaria o seu atendimento."
            />
          )
        }

        {
          hasWhatsApp && (
            <section class="channel" aria-labelledby="canal-whatsapp">
              <h2 class="channel__title" id="canal-whatsapp">
                WhatsApp
              </h2>
              <p class="channel__hint">
                O caminho mais rápido. Fale com quem preferir — os três atendem, e
                a conversa já abre com uma mensagem pronta que você pode editar.
              </p>
              <ul class="people">
                {zapChannels.map((c) => (
                  <li>
                    <a
                      class="person"
                      href={c.href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <span class="person__text">
                        <span class="person__name">{c.name}</span>
                        <span class="person__number">{c.label}</span>
                      </span>
                      <span class="person__action">
                        <span class="visually-hidden">Abrir conversa com {c.name}</span>
                        <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" focusable="false">
                          <path
                            d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          hasEmail && (
            <section class="channel" aria-labelledby="canal-email">
              <h2 class="channel__title" id="canal-email">
                E-mail
              </h2>
              <p class="channel__hint">
                Para briefings mais longos, listas de itens ou envio dos arquivos
                da marca. Qualquer um dos endereços chega à equipe.
              </p>
              <ul class="mails">
                {mailChannels.map((c) => (
                  <li>
                    <a class="mails__link" href={c.href}>
                      {c.label}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <section class="channel" aria-labelledby="canal-projeto">
          <h2 class="channel__title" id="canal-projeto">
            Prefere escrever antes?
          </h2>
          <p class="channel__hint">
            A página de projetos personalizados tem um campo para você descrever a
            ação com calma. O texto vai junto quando escolher o canal.
          </p>
          <a class="btn btn--ghost btn--sm" href="/projetos-personalizados">
            Descrever o que preciso
          </a>
        </section>
      </div>

      <aside class="contact__aside">
        <section>
          <h2 class="aside__title">O que ajuda no primeiro contato</h2>
          <p class="aside__lede">
            Nada disso é obrigatório. Quanto mais claro o objetivo, mais rápido a
            proposta fica de pé.
          </p>
          <dl class="checklist">
            {
              briefing.map((item) => (
                <div class="checklist__row">
                  <dt class="utility">{item.label}</dt>
                  <dd>{item.text}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section class="shortcuts">
          <h2 class="aside__title">Enquanto isso</h2>
          <ul>
            <li><a href="/catalogo">Explorar o catálogo</a></li>
            <li><a href="/solucoes">Ver soluções por ocasião</a></li>
            <li><a href="/perguntas-frequentes">Perguntas frequentes</a></li>
          </ul>
        </section>
      </aside>
    </div>

    <section class="identity" aria-labelledby="identidade">
      <h2 class="utility" id="identidade">Dados da empresa</h2>
      <dl class="identity__list">
        <div>
          <dt class="utility">Razão social</dt>
          <dd>{siteConfig.legalName}</dd>
        </div>
        <div>
          <dt class="utility">CNPJ</dt>
          <dd>{siteConfig.cnpj}</dd>
        </div>
      </dl>
      <p class="identity__note">
        Endereço cadastrado e informações de privacidade em
        {" "}<a href="/politica-de-privacidade">Privacidade</a>.
      </p>
    </section>
  </div>
</Base>

<script>
  // O botao de orcamento manda produto e quantidade na URL. Sao dados do
  // visitante: entram sempre por textContent, com tamanho limitado, e a
  // quantidade so aceita digitos.
  const brief = document.querySelector<HTMLElement>("[data-brief]");
  if (brief) {
    const params = new URLSearchParams(location.search);
    const subject = (params.get("assunto") ?? "").trim().slice(0, 120);
    const qty = (params.get("qtd") ?? "").replace(/\D/g, "").slice(0, 7);
    const desc = (params.get("descricao") ?? "").replace(/\s+/g, " ").trim().slice(0, 600);

    const subjectEl = brief.querySelector<HTMLElement>("[data-brief-subject]");
    const qtyEl = brief.querySelector<HTMLElement>("[data-brief-qty]");
    const descEl = brief.querySelector<HTMLElement>("[data-brief-desc]");

    if (subject && subjectEl) {
      subjectEl.textContent = `Interesse: ${subject}`;
      subjectEl.hidden = false;
    }
    if (qty && qtyEl) {
      qtyEl.textContent = `Quantidade estimada: ${qty} ${qty === "1" ? "unidade" : "unidades"}`;
      qtyEl.hidden = false;
    }
    if (desc && descEl) {
      descEl.textContent = desc;
      descEl.hidden = false;
    }
    brief.hidden = !subject && !qty && !desc;
  }
</script>

<style>
  /* `display` explicito vence o `[hidden]` do navegador. Sem esta regra o bloco
     aparece vazio para quem chega ao /contato sem vir de um botao de orçamento. */
  .brief[hidden] {
    display: none;
  }

  .brief {
    display: grid;
    gap: var(--space-2xs);
    margin-block-end: var(--space-xl);
    padding: var(--space-m) var(--space-l);
    background: var(--blue-100);
    border-inline-start: 3px solid var(--brand-yellow);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .brief__item {
    margin: 0;
    color: var(--brand-blue);
    font-weight: var(--weight-strong);
  }

  .brief__text {
    margin: 0;
    color: var(--text);
    /* Texto do visitante: quebra onde ele quiser, sem estourar a caixa. */
    overflow-wrap: anywhere;
  }

  .brief__note {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .contact {
    display: grid;
    gap: var(--space-2xl);
  }

  @media (min-width: 900px) {
    .contact {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: var(--space-3xl);
      align-items: start;
    }
  }

  .contact__main {
    display: grid;
    gap: var(--space-2xl);
  }

  /* ------------------------------------------------------------- canais */
  .channel {
    display: grid;
    gap: var(--space-xs);
    justify-items: start;
  }

  .channel__title {
    display: grid;
    gap: var(--space-s);
    font-size: var(--step-2);
  }

  .channel__hint {
    margin: 0;
    color: var(--text-muted);
  }

  .people {
    display: grid;
    gap: var(--space-xs);
    width: 100%;
    margin-block-start: var(--space-xs);
    list-style: none;
  }

  .person {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    min-height: 68px;
    padding-inline: var(--space-m);
    background: var(--brand-white);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }

  .person:hover {
    border-color: var(--brand-blue);
    background: var(--blue-100);
  }

  .person__text {
    display: grid;
    gap: 1px;
  }

  .person__name {
    color: var(--brand-blue);
    font-size: var(--step-1);
    font-weight: var(--weight-strong);
    line-height: 1.3;
  }

  .person__number {
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .person__action {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 36px;
    height: 36px;
    background: var(--brand-yellow);
    border-radius: 999px;
    color: var(--brand-blue);
  }

  .mails {
    display: grid;
    gap: var(--space-2xs);
    margin-block-start: var(--space-xs);
    list-style: none;
  }

  .mails__link {
    display: inline-flex;
    align-items: center;
    /* Alvo de toque proprio: sao links empilhados, nao texto corrido. */
    min-height: 44px;
    color: var(--brand-blue);
    font-weight: var(--weight-strong);
    overflow-wrap: anywhere;
  }

  /* -------------------------------------------------------------- apoio */
  .contact__aside {
    display: grid;
    gap: var(--space-xl);
    align-content: start;
    padding: var(--space-l);
    background: var(--surface-muted);
    border-radius: var(--radius-lg);
  }

  .aside__title {
    font-size: var(--step-2);
  }

  .aside__lede {
    margin: var(--space-2xs) 0 0;
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .checklist {
    display: grid;
    gap: var(--space-m);
    margin: var(--space-m) 0 0;
  }

  .checklist__row {
    display: grid;
    gap: 2px;
    padding-inline-start: var(--space-s);
    border-inline-start: 2px solid var(--brand-yellow);
  }

  .checklist__row dt,
  .checklist__row dd {
    margin: 0;
  }

  .checklist__row dd {
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .shortcuts ul {
    display: grid;
    margin-block-start: var(--space-2xs);
    list-style: none;
  }

  .shortcuts a {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: var(--brand-blue);
    font-size: var(--step--1);
    font-weight: var(--weight-strong);
    text-decoration: none;
  }

  .shortcuts a:hover {
    text-decoration: underline;
  }

  /* ---------------------------------------------------------- identidade */
  .identity {
    margin-block: var(--space-3xl) 0;
    padding-block: var(--space-l) var(--space-4xl);
    border-block-start: 1px solid var(--line);
  }

  .identity__list {
    display: grid;
    gap: var(--space-m) var(--space-2xl);
    margin: var(--space-m) 0 0;
  }

  @media (min-width: 560px) {
    .identity__list {
      grid-template-columns: repeat(2, minmax(0, max-content));
    }
  }

  .identity__list dt,
  .identity__list dd {
    margin: 0;
  }

  .identity__list dd {
    color: var(--brand-blue);
    font-weight: var(--weight-strong);
    font-size: var(--step--1);
  }

  .identity__note {
    margin-block-start: var(--space-m);
    color: var(--text-muted);
    font-size: var(--step--1);
  }
</style>
